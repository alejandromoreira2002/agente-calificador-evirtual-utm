# ─────────────────────────────────────────────────────────────
#  Calificador Moodle — plantilla de credenciales
#
#  1) Copia este archivo como  .env   (en la misma carpeta)
#  2) Rellena tus valores
#  3) NUNCA subas el .env a GitHub: ya está incluido en .gitignore
# ─────────────────────────────────────────────────────────────

# Clave de la API del modelo que califica (DeepSeek).
# Se obtiene en https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-tu_clave_aqui

# Endpoint compatible con la API de OpenAI (puedes apuntar a otro proveedor)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Modelo que realiza la calificación
GRADER_MODEL=deepseek-v4-flash

# Sitio Moodle institucional (tiene prioridad sobre config.json).
# Debe tener activados los servicios web y el servicio «moodle_mobile_app».
MOODLE_SITE=https://tu-moodle.institucion.edu

# Clave de firma de las sesiones web de Flask.
# Genera una propia con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esta_clave_por_una_aleatoria

# Servidor web
#   HOST=0.0.0.0  → accesible desde toda la red local
#   HOST=127.0.0.1 → solo desde este equipo
HOST=0.0.0.0
PORT=5050
